generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  MANAGER
  ADMIN
}
// enum ReportStatus { DRAFT SUBMITTED NEEDS_CORRECTION APPROVED }
// enum Priority     { LOW MEDIUM HIGH CRITICAL }
