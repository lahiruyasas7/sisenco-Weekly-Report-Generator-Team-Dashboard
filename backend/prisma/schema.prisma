generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Raw SQL constraints enforce report week rules, numeric bounds, one key blocker/achievement,
// non-negative currentVersion, and case-insensitive trimmed Project name uniqueness.

enum Role {
  MEMBER
  MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  COMPLETED
  IN_PROGRESS
  BLOCKED
  DEFERRED
}

enum TaskType {
  DEVELOPMENT
  TESTING
  MEETINGS
  DOCUMENTATION
  DESIGN
  OTHER
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  name               String
  passwordHash       String
  role               Role            @default(MEMBER)
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sessions           UserSession[]
  reports            Report[]
  reviews            Review[]
  versionsSubmitted  ReportVersion[]
  projectMemberships ProjectMember[]
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Project {
  id          String   @id @default(uuid())
  // Uniqueness is enforced by LOWER(BTRIM(name)) in SQL, which Prisma cannot model.
  name        String
  description String?
  color       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  reports Report[]

  @@index([isArchived, name])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Report {
  id               String       @id @default(uuid())
  userId           String
  projectId        String?
  weekStart        DateTime     @db.Date
  weekEnd          DateTime     @db.Date
  status           ReportStatus @default(DRAFT)
  currentVersion   Int          @default(0)
  notes            String?
  links            String[]
  submittedAt      DateTime?
  firstSubmittedAt DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  tasks         ReportTask[]
  nextWeekTasks NextWeekTask[]
  blockers      Blocker[]
  achievements  Achievement[]
  timeEntries   TimeEntry[]
  versions      ReportVersion[]
  reviews       Review[]

  @@unique([userId, weekStart])
  @@index([status])
  @@index([weekStart])
  @@index([projectId])
}

model ReportTask {
  id             String     @id @default(uuid())
  reportId       String
  position       Int
  name           String     @default("")
  priority       Priority   @default(MEDIUM)
  plannedPercent Int        @default(0)
  actualPercent  Int        @default(0)
  status         TaskStatus @default(IN_PROGRESS)
  plannedHours   Float      @default(0)
  spentHours     Float      @default(0)
  output         String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
}

model NextWeekTask {
  id             String   @id @default(uuid())
  reportId       String
  position       Int
  description    String   @default("")
  priority       Priority @default(MEDIUM)
  estimatedHours Float?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
}

model Blocker {
  id          String  @id @default(uuid())
  reportId    String
  position    Int
  description String  @default("")
  isKey       Boolean @default(false)
  isResolved  Boolean @default(false)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
}

model Achievement {
  id          String  @id @default(uuid())
  reportId    String
  position    Int
  description String  @default("")
  isKey       Boolean @default(false)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
}

model TimeEntry {
  id       String   @id @default(uuid())
  reportId String
  taskType TaskType
  hours    Float    @default(0)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, taskType])
}

model ReportVersion {
  id            String   @id @default(uuid())
  reportId      String
  versionNumber Int
  snapshot      Json
  submittedById String
  submittedAt   DateTime @default(now())

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  submittedBy User     @relation(fields: [submittedById], references: [id])
  reviews     Review[]

  @@unique([reportId, versionNumber])
}

model Review {
  id         String       @id @default(uuid())
  reportId   String
  versionId  String
  reviewerId String
  action     ReviewAction
  comment    String?
  createdAt  DateTime     @default(now())

  report   Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version  ReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer User          @relation(fields: [reviewerId], references: [id])

  @@unique([versionId])
  @@index([reportId])
  @@index([createdAt])
}
